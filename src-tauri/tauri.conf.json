{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Extinction-MiniJeux",
  "version": "2.0.0",
  "identifier": "fr.extinction-minijeux.game",
  "build": {
    "frontendDist": "https://extinction-minijeux.fr/client",
    "devUrl": "https://extinction-minijeux.fr/client",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Extinction-MiniJeux",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
